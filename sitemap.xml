---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  {% for page in site.pages %}{% if page.layout == 'artigo' %}
  <url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>
  {% endif %}{% endfor %}
  {% for post in site.artigos %}
  <url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
</urlset>
